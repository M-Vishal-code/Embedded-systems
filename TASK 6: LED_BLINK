    PORTCbits.RC3 = 0x00;
    
    while(1){
        RC1 = 1;
        __delay_ms(5000);
        
        RC1 = 0;
      //  __delay_ms();
        
        RC2 = 1;
        __delay_ms(2000);
        
        RC2 = 0;
        //__delay_ms();
        
        RC3 = 1;
        __delay_ms(3000);
        
        RC3 = 0;
        //__delay_ms();
        
    }
    return;
}
